{
  // Rules are evaluated top-to-bottom.
  // The first matching rule wins.
  //
  // Different match fields are ANDed.
  // Array values within a match field are ORed.
  // A single string is treated as a one-item array.
  // Matching is case-insensitive.
  // to_* / to_local_* read the To header only.
  // Unknown match fields and empty matches stop the run; see docs/rule-reference.md.

  "aerospace.biz": {
    "rules": [
      {
        "name": "Health messages",
        "match": {
          "subject_contains": ["health"],
        },
        "do": {
          "delete": true,
        },
      },

      {
        "name": "Services payments",
        "match": {
          "to_is": ["payments@aerospace.biz"],
        },
        "do": {
          "move": "services_payments",
          "mark_read": true,
        },
      },
    ],

    // Optional: applies only when no rule above matches.
    "catch_all": {
      "move": "archive",
    },
  },

  "gmail-personal": {
    "rules": [
      {
        "name": "GitHub mail",
        "match": {
          "from_email_contains": ["github.com"],
        },
        "do": {
          "move": "github_main",
        },
      },
    ],
  },
}
