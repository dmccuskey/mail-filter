{
  // Folder mappings are per account, keyed by account ID.
  //
  // The keys on the left are logical folder names used by rules.
  // The values on the right are the actual IMAP mailbox names.
  //
  // "trash" is optional: without it, the trash action uses the mailbox the
  // server advertises with \Trash. Set it to override that, or for a server
  // that does not advertise \Trash.

  "aerospace.biz": {
    "inbox": "INBOX",
    "health_delete": "INBOX.Health.To Delete",
    "services_payments": "INBOX.Services.Payments",
    "archive": "INBOX.Archive",
    "trash": "INBOX.Trash"
  },

  "gmail-personal": {
    "inbox": "INBOX",
    "github_main": "GitHub",
    "promotions": "[Gmail]/Promotions",
    "trash": "[Gmail]/Trash"
  }
}
